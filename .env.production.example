APP_NAME="GuardOps SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.guardops.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=guard_saas
DB_USERNAME=guardops
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.guardops.com
SESSION_SAME_SITE=lax
REDIS_HOST=redis
REDIS_PORT=6379

# Chromium runs only on the queue-heavy container (Browsershot ID cards).
ID_CARD_PDF_DRIVER=browsershot
CHROME_PATH=/usr/bin/chromium
NODE_BINARY=/usr/bin/node
NPM_PATH=/usr/bin/npm

FILESYSTEM_DISK=s3
TENANT_FILES_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=app.guardops.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@guardops.com
MAIL_FROM_NAME="${APP_NAME}"

TENANCY_BASE_DOMAIN=guardops.com

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=NGN

SSO_ENABLED=false
SSO_PROVIDER=oidc
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_ISSUER=

PUSH_NOTIFICATIONS_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@guardops.com

SMS_NOTIFICATIONS_ENABLED=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

GUARD_IDLE_ALERT_MINUTES=15
